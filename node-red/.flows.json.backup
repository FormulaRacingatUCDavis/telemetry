    },
    {
        "id": "99468b103ff3f9f0",
        "type": "function",
        "z": "999c06ba44161ae7",
        "name": "CanframeHandler",
        "func": "let message = msg.payload\nlet dataType = message[\"data_type\"]\n\nswitch (dataType) {\n    case \"mcac_power\":\n        msg.payload = message[\"dashboard_state\"];\n        break;\n    default:\n        node.error(\"Data type invalid.\", msg)\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 970,
        "y": 800,
        "wires": [
            [
                "4024201e860a2bd4",
                "94e82c839d193d5c"
            ]
        ]
    },
    {
        "id": "4024201e860a2bd4",
        "type": "debug",
        "z": "999c06ba44161ae7",
        "name": "Data Output",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "payload",
