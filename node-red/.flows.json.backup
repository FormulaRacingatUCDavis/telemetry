    {
        "id": "86f5141cef4b9c1a",
        "type": "function",
        "z": "999c06ba44161ae7",
        "name": "Build ZIP request",
        "func": "\nconst files = flow.get(\"selectedFiles\") || [];\nconst type = flow.get(\"logType\");\n\nfunction error(message) {\n    return [null, { payload: message }];\n}\n\nif (!files.length || !type) {\n    return error(\"Please select files and a log type.\");\n}\n\nif (type === \"processed\") {\n    const missing = files.filter(file =>\n        file.file_size_parsed === \"N/A\"\n    );\n\n    if (missing.length > 0) {\n        return error(\n            `${missing.length} selected file(s) have no parsed version.`\n        );\n    }\n}\n\nmsg.payload = {\n    filenames: files.map(file => file.file_name),\n    type: type\n};\n\nmsg.downloadId = msg._msgid;\n\nreturn [msg, null];\n",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 450,
        "y": 280,
        "wires": [
            [
                "69ab87a0b7b48fe4"
            ],
            [
                "e221a1f6b94791c5"
            ]
        ]
    },
