    {
        "id": "0440131f33902df9",
        "type": "function",
        "z": "999c06ba44161ae7",
        "name": "CanframeHandler",
        "func": "let topic = msg.payload\n\n// Error handling for empty selections (default)\nif (!topic || typeof topic !== \"string\") {\n    node.error(\"Canframe not selected.\", msg)\n    return null;\n}\n\n// Tell mqtt to subscribe to current selection topic\nmsg.action = \"subscribe\"\nmsg.topic = topic\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 570,
        "y": 800,
        "wires": [
            [
                "014fa79b2d36edf4"
            ]
        ]
    },
    {
        "id": "696e989aa1a73ed8",
        "type": "debug",
        "z": "999c06ba44161ae7",
        "name": "Canframe Output",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "payload",
        "targetType": "msg",
        "statusVal": "",
        "statusType": "auto",
