    {
        "id": "69ab87a0b7b48fe4",
        "type": "ui-template",
        "z": "999c06ba44161ae7",
        "group": "fc0502477daedbd4",
        "page": "",
        "ui": "",
        "name": "Download in browser",
        "order": 4,
        "width": 0,
        "height": 0,
        "head": "",
        "format": "\n<template>\n  <div style=\"display: none\"></div>\n</template>\n\n<script>\nexport default {\n  watch: {\n    async msg(msg) {\n      if (!msg?.payload?.filenames || !msg?.downloadId) return\n\n      const key = \"lastDownloadId\"\n\n      if (sessionStorage.getItem(key) === msg.downloadId) return\n\n      sessionStorage.setItem(key, msg.downloadId)\n\n      const { filenames, type } = msg.payload\n\n      try {\n        const response = await fetch(\n          `http://127.0.0.1:8000/api/can/logs/zip/${type}`,\n          {\n            method: \"POST\",\n            headers: {\n              \"Content-Type\": \"application/json\"\n            },\n            body: JSON.stringify({ filenames })\n          }\n        )\n\n        if (!response.ok) {\n          throw new Error(`HTTP ${response.status}`)\n        }\n\n        const blob = await response.blob()\n        const url = URL.createObjectURL(blob)\n\n        const a = document.createElement(\"a\")\n        a.href = url\n        a.download = `canlogs-${type}.zip`\n        document.body.appendChild(a)\n        a.click()\n        a.remove()\n\n        setTimeout(() => URL.revokeObjectURL(url), 1000)\n\n      } catch (error) {\n        console.error(\"ZIP download failed:\", error)\n        sessionStorage.removeItem(key)\n      }\n    }\n  }\n}\n</script>\n",
        "storeOutMessages": true,
        "passthru": false,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
        "x": 700,
        "y": 240,
        "wires": [
            []
        ]
    },
