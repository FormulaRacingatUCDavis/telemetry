        "id": "6aaaebc8582defa3",
        "type": "function",
        "z": "999c06ba44161ae7",
        "name": "ChartHandler",
        "func": "let previousTopic = context.get(\"canState\")\nlet currentTopic = msg.payload\n\nif (previousTopic == undefined) {\n    context.set(\"canState\", currentTopic)\n    msg.payload = currentTopic\n}\n\n// Checks if selection has changed\n// Used to clear chart data array for new data stream\nif (previousTopic !== currentTopic) {\n    msg.payload = []\n    context.set(\"canState\", currentTopic)\n}\n\nreturn msg",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
