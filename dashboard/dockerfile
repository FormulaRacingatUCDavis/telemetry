FROM ubuntu:24.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        git \
        pkg-config \
        libmosquitto-dev \
        ca-certificates \
        curl \
        zip \
        unzip \
        tar \
        qt6-base-dev \
        qt6-declarative-dev \
        && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY . .

RUN cmake -S . -B build

RUN cmake --build build


FROM ubuntu:24.04

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        libmosquitto1 \
        libqt6quick6 \
        qt6-qpa-plugins \
        qml6-module-qtquick \
        qml6-module-qtquick-layouts \
        qml6-module-qtqml-workerscript \
        qml6-module-qtquick-window \
    && rm -rf /var/lib/apt/lists/*


WORKDIR /app

COPY --from=builder /app/build/driver_dashboard ./driver_dashboard

CMD ["./driver_dashboard"]